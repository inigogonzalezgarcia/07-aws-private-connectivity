# Copy to terraform.tfvars (ignored by git) and adjust.
region                = "eu-west-1"
name                  = "pl-lab"
provider_cidr         = "10.10.0.0/16"
consumer_cidr         = "10.20.0.0/16"
az_count              = 2
service_port          = 8080
private_zone          = "internal.example"
create_test_instances = true

